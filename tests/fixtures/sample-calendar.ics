BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Task Notes//Sample calendar//EN
CALSCALE:GREGORIAN
X-WR-CALNAME:Sample calendar
BEGIN:VTIMEZONE
TZID:Europe/Berlin
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:sample-allday-1@task-notes
SUMMARY:Public holiday (all-day)
DTSTART;VALUE=DATE:20260810
DTEND;VALUE=DATE:20260811
END:VEVENT
BEGIN:VEVENT
UID:sample-allday-2@task-notes
SUMMARY:Conference (three days, all-day)
DTSTART;VALUE=DATE:20260812
DTEND;VALUE=DATE:20260815
END:VEVENT
BEGIN:VEVENT
UID:sample-timed-1@task-notes
SUMMARY:Standup (Berlin time)
DTSTART;TZID=Europe/Berlin:20260810T093000
DTEND;TZID=Europe/Berlin:20260810T094500
END:VEVENT
BEGIN:VEVENT
UID:sample-timed-2@task-notes
SUMMARY:Design review
DTSTART;TZID=Europe/Berlin:20260811T140000
DTEND;TZID=Europe/Berlin:20260811T153000
END:VEVENT
BEGIN:VEVENT
UID:sample-timed-utc@task-notes
SUMMARY:Call with New York (UTC in the file)
DTSTART:20260812T160000Z
DTEND:20260812T170000Z
END:VEVENT
BEGIN:VEVENT
UID:sample-weekly@task-notes
SUMMARY:Weekly sync
DTSTART;TZID=Europe/Berlin:20260803T110000
DTEND;TZID=Europe/Berlin:20260803T120000
RRULE:FREQ=WEEKLY;BYDAY=MO;COUNT=8
END:VEVENT
BEGIN:VEVENT
UID:sample-weekly@task-notes
SUMMARY:Weekly sync (moved this week)
RECURRENCE-ID;TZID=Europe/Berlin:20260817T110000
DTSTART;TZID=Europe/Berlin:20260817T160000
DTEND;TZID=Europe/Berlin:20260817T170000
END:VEVENT
BEGIN:VEVENT
UID:sample-declined@task-notes
SUMMARY:A meeting you declined
DTSTART;TZID=Europe/Berlin:20260813T100000
DTEND;TZID=Europe/Berlin:20260813T110000
ATTENDEE;CN=You;PARTSTAT=DECLINED:mailto:you@example.com
END:VEVENT
BEGIN:VEVENT
UID:sample-overnight@task-notes
SUMMARY:Night shift (crosses midnight)
DTSTART;TZID=Europe/Berlin:20260814T220000
DTEND;TZID=Europe/Berlin:20260815T060000
END:VEVENT
END:VCALENDAR
