{
  "name": "task-notes",
  "version": "4.4.0",
  "description": "Obsidian plugin: note-as-event timeblocking, calendar, remote ICS calendars and notifications.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check && node esbuild.config.mjs production",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -noEmit -skipLibCheck && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "day-planner",
    "calendar",
    "timeblocking"
  ],
  "author": "Benedikt Hollerauer",
  "license": "MIT",
  "dependencies": {
    "ical.js": "^2.1.0",
    "obsidian-daily-notes-interface": "^0.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.10.0",
    "@typescript-eslint/utils": "^8.67.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.8",
    "esbuild-svelte": "^0.9.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.0.0",
    "happy-dom": "^20.11.2",
    "moment": "^2.30.1",
    "obsidian": "latest",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.0",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.53.0",
    "vitest": "^3.0.0"
  }
}
